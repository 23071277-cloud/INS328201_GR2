# Energy & Utility DSS - cấu hình môi trường. Sao chép thành .env rồi chỉnh.
# Chú ý: comment phải nằm trên DÒNG RIÊNG (không viết "KEY=value # comment").

APP_NAME="Energy & Utility DSS"
# local | production
APP_ENV=local
# false = trang lỗi chung, không lộ chi tiết (BẮT BUỘC false khi vận hành thật). true chỉ dùng khi phát triển.
APP_DEBUG=false
# URL tới thư mục public/ (không có dấu / ở cuối)
APP_URL=http://localhost/energy-dss/public
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Mặc định khi bảng system_configs không đọc được (giá trị đang dùng chỉnh tại /system-parameters)
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# XAMPP: 3306; MAMP: 8889
DB_PORT=3306
# Schema hiện hành v2 (27 bảng trong database/energy_dss_v2.sql: 26 bảng 3NF + payment_transactions; từ 04/10/2026). Rollback: energy_dss (schema v1, giữ nguyên) - xem README mục 10.
DB_DATABASE=energy_dss_v2
# XAMPP: root / (trống); MAMP: root / root. Vận hành thật: user riêng + mật khẩu mạnh, KHÔNG dùng root.
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# FN-10.03 Gửi thông báo phí qua email (STEP 25). KHÔNG ghi thông tin đăng nhập thật vào file mẫu này.
# MAIL_DRIVER: log = demo offline (không gửi ra Internet) | smtp = gửi thật | array = chỉ dùng cho test
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
# 587 + tls (STARTTLS) hoặc 465 + ssl
MAIL_PORT=587
MAIL_ENCRYPTION=tls
# Địa chỉ Gmail dùng để gửi
MAIL_USERNAME=
# App Password 16 ký tự của Gmail (KHÔNG dùng mật khẩu Gmail chính) - xem README "Gmail SMTP Setup"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Energy DSS"
MAIL_TIMEOUT=15
# Chỉ để chạy tests/support/gmail_smoke.php (gửi 1 thư thật). Để trống = bỏ qua.
MAIL_TEST_RECIPIENT=

# Payment module - nhận callback từ Mock Bank (ứng dụng giả lập ĐỘC LẬP tools/mock-bank, không phải ngân hàng thật). Production để TẮT.
# Bật (chỉ demo) cần CẢ HAI: MOCK_BANK_ENABLED=1 và MOCK_BANK_SECRET (>= 16 ký tự, ký HMAC-SHA256). Demo local: Mock Bank http://localhost/mock-bank/ (secret trùng trong tools/mock-bank/config.local.php) - xem docs/DEMO_FINAL.md mục 4.
MOCK_BANK_ENABLED=0
MOCK_BANK_SECRET=
